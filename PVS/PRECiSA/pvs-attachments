(defun compute-upper-bound-on-array-function-definition
    (decl-id
     theory-ref
     &optional
       (precision 3)
       (maxdepth 10)
       min?
       max?
       dirvar)
  "Given a declaration ID and a theory reference,
   extracts the definition, identifies array variables and their corresponding ranges,
   and computes an upper bound for the unrolled array expression.

   Array variables are matched to ranges using naming convention:
   e.g., array variable r_x matches with range constant x_range

   DECL-ID: Symbol ID of the constant to analyze (e.g., '|errorExpression|)
   THEORY-REF: String reference to the theory containing the declaration
   PRECISION, MAXDEPTH, MIN?, MAX?, DIRVAR: Parameters for compute-upper-bound-with-numerical

   Returns: A concrete upper bound for the expression, or NIL if unbounded."
  (let ((theory-id (multiple-value-bind (dir file th)
                       (get-theory-ref theory-ref)
                     (declare (ignore dir file))
                     (makesym th))))
    (let ((decl (get-referenced-declaration* decl-id '|const-decl| nil theory-id nil)))
      (with-theory (th) theory-id
        (let*((definition (definition decl))
              ;; Collect all const-decl declarations from the theory
              (all-decls (all-declarations th))
              ;; Find range declarations by checking their type is Interval
              (range-decls (loop for d in all-decls
                                 when (and (const-decl? d)
                                          (let*((d-type (type d))
                                                (print-type (if (subtype? d-type)
                                                                (let ((top-type (or (top-type d-type) (supertype d-type))))
                                                                  (if top-type (print-type top-type) (print-type d-type)))
                                                                (print-type d-type)))
                                                (type-id (and print-type (id print-type))))
                                            (eq type-id '|Interval|)))
                                 collect d))
              ;; Find VAR declarations for arrays or reals
              (var-decls (loop for d in all-decls
                               when (and (var-decl? d)
                                        (let((d-type (type d)))
                                          (or (let ((ptd (print-type d-type)))
                                                (and ptd
                                                     (print-type-name? ptd)
                                                     (eq (id ptd) '|real|)))
                                              (let*((print-type (if (subtype? d-type)
                                                                   (let ((top-type (or (top-type d-type) (supertype d-type))))
                                                                     (if top-type (print-type top-type) (print-type d-type)))
                                                                   (print-type d-type)))
                                                   (type-id (and print-type (id print-type))))
                                                (eq type-id '|aarray|)))))
                               collect d))
              ;; Build mapping from array variable names to their ranges
              ;; Convention: r_x -> x_range
              (array-vars-with-ranges
               (loop for var-decl in var-decls
                     for var-name = (id var-decl)
                     for var-name-str = (string var-name)
                     ;; Extract the suffix after "r_" (e.g., "x" from "r_x")
                     for suffix = (if (> (length var-name-str) 2)
                                      (subseq var-name-str 2)
                                      nil)
                     ;; Find corresponding range with pattern: <suffix>_range
                     for range-decl = (when suffix
                               (let((range-name (makesym (format nil "~a_range" suffix))))
                                 (loop for rd in range-decls
                                       when (eq (id rd) range-name)
                                       return rd)))
                     when range-decl
                     ;; Format as ("var_name" range-expr-object)
                     collect (list var-name-str (format nil "~a" (definition range-decl))))))
          ;; Call compute-upper-bound-on-unrolled-array-expr with the extracted info
          (let ((*unroll-indexing-map* nil))
            (compute-upper-bound-on-unrolled-array-expr
             definition
             array-vars-with-ranges
             precision
             maxdepth
             min?
             max?
             dirvar)))))))

