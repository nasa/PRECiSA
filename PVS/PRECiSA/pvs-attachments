  (defun has-lhash-repetitions? (lht)
    "Check if there are shadowed keys (repetitions) by comparing total unique
     keys from map-lhash against sum of all keys at each level."
    (let ((unique-count 0)
          (total-count 0))
      ;; Count unique keys using map-lhash (which skips duplicates)
      (map-lhash #'(lambda (key value)
                     (declare (ignore key value))
                     (incf unique-count))
                 lht)
      ;; Count all keys at all levels
      (do ((current lht (lhash-next current)))
          ((null current))
        (when (hash-table-p (lhash-table current))
          (incf total-count (hash-table-count (lhash-table current)))))
      ;; If unique < total, there are repetitions
      (< unique-count total-count)))


(defun find-lhash-duplicates (lht)
    "Returns a list of keys that appear at multiple levels in the linked-hash-table."
    (let ((key-levels (make-hash-table :test (hash-table-test
                                               (lhash-table lht))))
          (duplicates nil))
      (do ((current lht (lhash-next current))
           (level 0 (1+ level)))
          ((null current))
        (when (hash-table-p (lhash-table current))
          (maphash #'(lambda (key value)
                       (declare (ignore value))
                       (if (gethash key key-levels)
                           (pushnew key duplicates :test #'equal)
                           (setf (gethash key key-levels) level)))
                   (lhash-table current))))
      duplicates))

;;
;; Combines unroll-array-functions and compute-upper-bound-with-numerical
;;

(defun extract-array-name-from-scalar-id (scalar-id)
  "Extracts the array variable name from a generated scalar ID.
   Scalar IDs are formatted as 'array_name_index', so we extract everything before the last underscore."
  (let ((last-underscore-pos (position #\_ scalar-id :from-end t)))
    (if last-underscore-pos
        (subseq scalar-id 0 last-underscore-pos)
        scalar-id)))

(defun compute-upper-bound-on-unrolled-array-expr
    (expr
     array-vars-with-ranges
     &optional
       (precision 3)
       (maxdepth 10)
       min?
       max?
       dirvar)
  "Given a PVS expression containing array-indexed function applications,
   expands all array functions and replaces array indexing with scalar variables,
   then computes an upper bound for the resulting expression.

   EXPR: A PVS ground expression (as a string or expression object)
   ARRAY-VARS-WITH-RANGES: A list of (array-var-name interval-spec) pairs
     where array-var-name is the name of an array variable in the original expression
     and interval-spec is its range (e.g., \"[|-1,1|]\")
   PRECISION: Decimal precision for numerical solver (default 3)
   MAXDEPTH: Maximum search depth for branch-and-bound (default 10)
   MIN?, MAX?, DIRVAR: Optional parameters for compute-upper-bound-with-numerical

   Returns: A concrete upper bound for the expanded expression, or NIL if unbounded."
  (let ((*unroll-indexing-map* nil))
    (let*((ia-expr (extra-get-expr expr))
          (unrolled-expr (unroll-array-functions ia-expr)))
      ;; Build a list of (scalar-var-name range) pairs from the generated scalar variables
      ;; by looking up the range of their parent array in array-vars-with-ranges
      (let ((generated-scalar-vars
             (loop for (scalar-id . scalar-binding) in *unroll-indexing-map*
                   for array-name = (extract-array-name-from-scalar-id scalar-id)
                   for range-entry = (assoc array-name array-vars-with-ranges :test #'equal)
                   when range-entry
                   collect (list scalar-id (cadr range-entry)))))
        ;; Combine original array variable ranges with generated scalar variable ranges
        (let ((all-vars (append array-vars-with-ranges generated-scalar-vars)))
          ;; Call compute-upper-bound-with-numerical with the unrolled expression
          ;; and the complete variable ranges
          (compute-upper-bound-with-numerical
           unrolled-expr
           all-vars
           precision
           maxdepth
           min?
           max?
           dirvar))))))

