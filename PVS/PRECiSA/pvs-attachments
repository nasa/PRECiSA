(defun expand-in-expr (name expr)
  "Expands all the apparitions of NAME in EXPR"
  (let ((simplified (simplify-expression expr :strategy `(expand ,name))))
    (if (forall-expr? simplified)
        (expression simplified)
        simplified)))

(defun array-indexing-expr? (app)
  (and (field-application? (operator app))
       (number-expr? (argument app))))

(defparameter *unroll-indexing-map* nil)

(defun unroll-indexing-expression (idx-expr)
  (let ((scalar-type (type idx-expr))
        (scalar-id   (format nil "~a_~a" (id (argument (operator idx-expr))) (number(argument idx-expr)))))
    (let*((scalar-binding
           (let ((cached-bind (assoc scalar-id *unroll-indexing-map* :test #'equal)))
             (if cached-bind
                 (cdr cached-bind)
                 (let ((bind (make-bind-decl (makesym scalar-id) scalar-type)))
                   (setq *unroll-indexing-map* (acons scalar-id bind *unroll-indexing-map*))
                   bind)))))
      (mk-name-expr (makesym scalar-id) nil nil (make-resolution scalar-binding (current-theory-name) scalar-type)))))

;; copying
(defmethod unroll-array-functions ((expr application))
  ;; if some of the arguments is an (subtype of) abstract array
  ;; the application gets unrolled
  ;; (break)
  (cond
    ((arg-tuple-expr? (argument expr))
      (let ((args (exprs(argument expr))))
        (if (some (lambda (arg) (let*((arg-type (type arg))
                                      (print-type (if (subtype? arg-type)
                                                      (let ((top-type (top-type arg-type)))
                                                        (if top-type (print-type top-type) (print-type arg-type)))
                                                      (print-type arg-type)))
                                      (arg-type-id (and print-type (id print-type))))
                                  (eq arg-type-id '|aarray|)))
                  args)
            (unroll-array-functions (expand-in-expr (id (operator* expr)) expr))
            (copy expr
                  'argument (copy (argument expr)
                                  'exprs (loop for arg in (exprs (argument expr))
                                               collect (unroll-array-functions arg)))))))
    ((array-indexing-expr? expr)
     ;; if it's an array indexation, replace it by a new scalar variable
     (unroll-indexing-expression expr))
    (t (let((arg (argument expr)))
         (let*((arg-type (type arg))
               (print-type (if (subtype? arg-type)
                               (let ((top-type (top-type arg-type)))
                                 (if top-type (print-type top-type) (print-type arg-type)))
                               (print-type arg-type)))
               (arg-type-id (and print-type (id print-type))))
           (if (eq arg-type-id '|aarray|)
               (unroll-array-functions (expand-in-expr (id (operator* expr)) expr))
               (copy expr 'argument (unroll-array-functions arg))))))))

(defmethod unroll-array-functions (obj)
  (copy obj 'free-variables 'unbound))


