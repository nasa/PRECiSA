;; (compute-upper-bound-with-numerical "ulp(r1_0__)" '(("r1_0__" "[|-4,4|]")))
(defun compute-upper-bound-with-numerical
    (expr
     &optional
       vars
       (precision 3)
       (maxdepth 10)
       min?
       max?
       dirvar)
  ""
  (let ((subs (append *precisa-builtin* *ia-builtin*)))
    (let*((accuracy  (ratio2decimal (expt 10 (- precision)) nil precision))
          (ia-expr (extra-get-expr expr))
          (fms       nil)
          (vars      (ia-complete-vars (enlist-it vars) (ia-get-vars-from-expr ia-expr subs)))
          (initeqs   (extra-reset-evalexprs))
          (ia-vars (extra-get-var-ranges fms vars))
          (unvars    (ia-find-unbound-vars ia-vars))
          (ia-box    (ia-box ia-vars))
          (m_or_m    (+ (if min? -1 0) (if max? 1 0)))
          (ia-iexpr (ia-interval-expr ia-expr precision ia-vars subs))
          (ia-dirvar (or dirvar (cond ((< m_or_m 0) "mindir_maxvar")
				      ((> m_or_m 0) "maxdir_maxvar")
				      (t "altdir_maxvar"))))
          (maxdepth  (if (null ia-vars) 0 maxdepth))
          (ia-eval   (format nil "numerical_bandb.numerical(~a,~a,~a,~a)(~a,~a)"
			     maxdepth accuracy ia-dirvar m_or_m ia-iexpr ia-box)))
      (let*((evaluable-expr (extra-get-expr ia-eval))
            (output (evalexpr evaluable-expr nil nil nil)))
        (let ((depth  (extra-get-number-from-expr (get-expr-from-obj output 'depth)))
	      (splits (get-expr-from-obj output 'splits))
	      (ans    (get-expr-from-obj output 'ans)))
          (unless (and (name-expr? ans) (eq (id ans) 'None))
            (let*((ans    (if (record-expr? ans) ans (args1 ans)))
                  (upperb (extra-get-number-from-expr 
			   (get-expr-from-obj ans 'mm 'ub))))
              upperb)))))))

